# Solo desarrollo local. Sustituir en cada servidor; nunca versionar .env.
# Servidores: ver docs/deployment.md (contraseña propia por entorno y COMPOSE_PROJECT_NAME si comparten host).
POSTGRES_DB=ateneo
POSTGRES_USER=ateneo
POSTGRES_PASSWORD=ateneo-local-only
WEB_PORT=8080
# API fuera de Docker (ver docs/api-contract.md). Compose aún no los pasa al servicio api (AT-13).
DATABASE_URL=postgresql+psycopg://ateneo:ateneo-local-only@localhost:5432/ateneo
ATENEO_TOKEN_TTL_SECONDS=28800
