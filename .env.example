# Solo desarrollo local. Sustituir en cada servidor; nunca versionar .env.
# Servidores: ver docs/deployment.md (contraseña propia por entorno y COMPOSE_PROJECT_NAME si comparten host).
POSTGRES_DB=ateneo
POSTGRES_USER=ateneo
# Va dentro de DATABASE_URL: usar solo caracteres seguros en URL (p. ej. `openssl rand -hex 24`).
POSTGRES_PASSWORD=ateneo-local-only
WEB_PORT=8080
ATENEO_TOKEN_TTL_SECONDS=28800
# Límite de subida de PDFs en MB. Nginx corta en 25; ver docs/deployment.md.
ATENEO_MAX_UPLOAD_MB=20
# API fuera de Docker (ver docs/api-contract.md). En Docker, Compose la construye con POSTGRES_*.
DATABASE_URL=postgresql+psycopg://ateneo:ateneo-local-only@localhost:5432/ateneo

# IA (solo backend). `fake` no usa red ni claves; `openai` = API compatible con OpenAI.
# Varias cuentas: *_API_KEYS separadas por comas (rotan ante 429, 5xx o timeout); si no, *_API_KEY.
ATENEO_LLM_PROVIDER=fake
ATENEO_LLM_API_KEYS=
ATENEO_LLM_MODEL=
ATENEO_LLM_BASE_URL=https://api.openai.com/v1
# Debe ser el mismo embedder (y dimensión) que indexó el corpus.
ATENEO_EMBEDDER=fake
ATENEO_EMBED_API_KEYS=
ATENEO_EMBED_MODEL=
ATENEO_EMBED_BASE_URL=https://api.openai.com/v1
ATENEO_EMBED_DIM=256
ATENEO_MAX_DISTANCE=0.5
